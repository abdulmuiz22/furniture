# Sassy Furniture Environment Variables

# MongoDB Connection (MongoDB Atlas recommended for Vercel Serverless)
# Make sure to allow Network Access: 0.0.0.0/0 in MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/furniture_sassy?retryWrites=true&w=majority

# Cloudinary Credentials (For high-resolution product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Access Passcode
ADMIN_PASSWORD=your_secure_admin_passcode

# Production App URL (Optional, defaults to VERCEL_PROJECT_PRODUCTION_URL on Vercel)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
